# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here

# App Configuration
PORT=8000
HOST=0.0.0.0
ENV=production

# PostgreSQL Configuration (Prisma / Supabase)
# Note: For Supabase production connection pooling, remember to use Session/Transaction URLs.
DATABASE_URL=postgresql://postgres:[password]@db.[supabase-project-id].supabase.co:5432/postgres?schema=public

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here
